{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "englishcommand",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "english-hunter",
      "database_id": "4485a43d-f0c5-487b-8a99-ca1e5f91ab8c"
    }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
